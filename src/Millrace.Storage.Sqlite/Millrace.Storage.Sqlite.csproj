<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQLite storage provider for Millrace: a durable, serverless queue for single-node deployments, local development and tests. Claims serialise through BEGIN IMMEDIATE rather than SKIP LOCKED. Verified by the Millrace.Storage.Verification conformance kit.</Description>
    <!--
      Not published yet (#151, slice 4 flips this). §11.14 makes IMonitoringStorage part of the bar
      for a supported provider and this one does not implement it yet, so releasing it now would
      promise something it does not do — permanently, because nuget.org has no delete. Leaving it
      unpackable means an unplanned tag between slices cannot ship a half-provider by accident.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Millrace\Millrace.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
