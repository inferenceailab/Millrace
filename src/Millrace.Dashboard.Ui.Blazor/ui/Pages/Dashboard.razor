@page "/"
@implements IAsyncDisposable
@inject DashboardClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js

@*
    The shell: masthead, tabs, and whichever view the hash names.

    Hash routing rather than Blazor's own router, which is what the React and Angular UIs do and for
    the same reason — the bundle is served at whatever prefix the consumer mounted (§11.23), and a
    path-routed link would have to know that prefix at build time. A fragment never reaches the
    server, so one prebuilt bundle works everywhere without configuration.
*@

<div class="layout">
    <header class="masthead">
        <h1>Millrace</h1>
        <span class="sub">Durable jobs and workflow orchestration</span>
        @if (_info is not null)
        {
            @* The backend's own report, so the header names the version and provider actually
               running rather than the one this bundle was built against. *@
            <span class="sub">@_info.ApiVersion · @_info.StorageProvider</span>
        }
    </header>

    <CascadingValue Value="_navigator" IsFixed="true">
        <nav class="tabs">
            @foreach (var tab in Tabs)
            {
                <a href="#@tab.Prefix"
                   aria-current="@(Current == tab.Prefix ? "page" : null)"
                   @onclick="() => GoAsync(tab.Prefix)"
                   @onclick:preventDefault>@tab.Label</a>
            }
        </nav>

        <main>
            @if (JobId is { } jobId)
            {
                @* Keyed on the id so following a continuation, or a requeue's new job, remounts the
                   view rather than leaving the previous job's data on screen. *@
                <JobDetail Id="@jobId" @key="jobId" />
            }
            else if (Current == "/jobs")
            {
                <Jobs />
            }
            else if (Current == "/recurring")
            {
                <Recurring />
            }
            else if (Current == "/instances")
            {
                <Instances />
            }
            else if (Current == "/signals")
            {
                <Signals />
            }
            else
            {
                <Overview />
            }
        </main>
    </CascadingValue>
</div>

@code {
    private static readonly (string Label, string Prefix)[] Tabs =
    [
        ("Overview", "/"),
        ("Jobs", "/jobs"),
        ("Recurring", "/recurring"),
        ("Workflows", "/instances"),
        ("Signals", "/signals"),
    ];

    private DashboardInfo? _info;
    private string _route = "/";
    private Navigator? _navigator;

    private string Current => Tabs.FirstOrDefault(
        tab => tab.Prefix != "/" && _route.StartsWith(tab.Prefix, StringComparison.Ordinal)).Prefix ?? "/";

    /// <summary>The job id in <c>#/jobs/{id}</c>, or null on every other route.</summary>
    private JobId? JobId
    {
        get
        {
            const string prefix = "/jobs/";
            if (!_route.StartsWith(prefix, StringComparison.Ordinal))
            {
                return null;
            }

            var rest = _route[prefix.Length..];
            return Guid.TryParse(rest, out var id) ? new JobId(id) : null;
        }
    }

    private IJSObjectReference? _router;
    private DotNetObjectReference<Dashboard>? _self;

    protected override async Task OnInitializedAsync()
    {
        // The address bar already carries a route when the page is opened from a bookmark or a
        // reload, so the first render honours it rather than always starting at the overview.
        _route = RouteFrom(Nav.Uri);
        _navigator = new Navigator(GoAsync);

        try
        {
            _info = await Api.GetInfoAsync();
        }
        catch (HttpRequestException)
        {
            // The header is decoration. A dashboard that will not render because it could not read
            // its own version number is worse than one with a gap in the header, and every view
            // below reports its own failure in the place the operator is looking.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Only for navigation this app did not initiate: back, forward, and a fragment typed into
        // the address bar. Its own links go through GoAsync, because a fragment-only anchor click is
        // swallowed by Blazor's link interception — measured as pushState 1, hashchange 0, and
        // LocationChanged silent, so there is no event to listen for.
        _router = await Js.InvokeAsync<IJSObjectReference>("import", "./hash-routing.js");
        _self = DotNetObjectReference.Create(this);
        await _router.InvokeVoidAsync("subscribe", _self);
    }

    /// <summary>Called from <c>hash-routing.js</c> on back, forward, or an edited fragment.</summary>
    [JSInvokable]
    public void HashChanged(string hash)
    {
        var route = string.IsNullOrEmpty(hash) || hash == "#" ? "/" : hash[1..];
        if (route != _route)
        {
            _route = route;
            StateHasChanged();
        }
    }

    /// <summary>Navigates, and writes the URL itself so back and deep links keep working.</summary>
    private async Task GoAsync(string route)
    {
        if (route == _route)
        {
            return;
        }

        _route = route;
        StateHasChanged();

        if (_router is not null)
        {
            await _router.InvokeVoidAsync("push", "#" + route);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_router is not null)
        {
            try
            {
                await _router.InvokeVoidAsync("unsubscribe");
                await _router.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away and took the JS side with it. Nothing to unhook.
            }
        }

        _self?.Dispose();
    }

    private static string RouteFrom(string uri)
    {
        var hash = uri.IndexOf('#', StringComparison.Ordinal);
        return hash < 0 || hash == uri.Length - 1 ? "/" : uri[(hash + 1)..];
    }
}
