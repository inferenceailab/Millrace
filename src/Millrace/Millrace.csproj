<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Durable job and workflow orchestration library for .NET. In-process, storage-agnostic, dashboard-included.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The merge rule is engine internals with no public surface, but it is exactly the kind of
         logic that deserves direct unit tests rather than only being exercised through a race. -->
    <InternalsVisibleTo Include="Millrace.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
