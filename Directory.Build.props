<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Millrace contributors</Authors>
    <Product>Millrace</Product>
    <PackageProjectUrl>https://github.com/inferenceailab/Millrace</PackageProjectUrl>
    <RepositoryUrl>https://github.com/inferenceailab/Millrace</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>jobs;background-jobs;workflow;orchestration;saga;scheduling;cron;durable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Reproducibility and debuggability (§11.31). Source Link ships in the SDK, so this needs no
    package reference — only the two properties that turn it on.
  -->
  <PropertyGroup Label="Reproducibility">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      Ships the XML docs, which are most of the interesting API and the part carrying the reasoning.

      CS1591 is no longer suppressed here (§11.34, closing #99): every public member outside the
      conformance kit is documented, and a new undocumented one is now a build error rather than a
      gap nobody sees. Millrace.Storage.Verification opts back in for itself, because public-ness
      there is an xUnit requirement rather than an API decision — the reasoning is on that project.

      CS1574 — an unresolvable cref — was never suppressed. That is a broken link in shipped
      documentation rather than a missing one, and it has since caught two.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1573 stays: the house style documents a member in prose rather than tagging every parameter,
      and turning this on would force <param> tags whose only content is the parameter's own name.
    -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

</Project>
